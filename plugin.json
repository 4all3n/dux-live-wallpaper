{
    "id": "mpvpaper",
    "name": "Live Wallpaper",
    "description": "Play and smoothly switch video wallpapers with multi-monitor support, slideshow/shuffle mode, battery-aware power saving, and a DankBar widget.",
    "version": "2.0.0",
    "author": "4all3n",
    "original_author": "tokisak1kurum1",
    "type": "composite",
    "capabilities": ["wallpaper", "daemon", "dankbar-widget"],
    "components": {
        "daemon": "./MpvPaperDaemon.qml",
        "widget": "./MpvPaperWidget.qml"
    },
    "settings": "./MpvPaperSettings.qml",
    "icon": "movie",
    "requires_dms": ">=1.6.2",
    "dependencies": ["mpvpaper", "ffmpeg"],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
